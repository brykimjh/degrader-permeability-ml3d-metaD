#!/bin/bash
#PBS -j oe
#PBS -q huge
#PBS -l select=1:ncpus=1:hpcluster=True
#PBS -N __JOB_NAME__

START_TIME=$(date +%s)
echo "Starting job at:" $(date)

module purge
source ~/github/clone/full/sfl-env2/bin/activate

MODEL="__MODEL__"
FEATURES="__FEATURES__"
SCRAMBLED="__SCRAMBLED__"
CSV_PATH="../../model_data.csv"
OUTDIR="."
PREDICT_CSV=""   # set to "../../new_unknowns.csv" to enable prediction mode
#PREDICT_CSV="../../unknowns.csv"

cd "$PBS_O_WORKDIR"

if [ -n "$PREDICT_CSV" ]; then
  CMD="python ../../run_model.py \
    --model $MODEL \
    --features $FEATURES \
    --csv $CSV_PATH \
    --outdir $OUTDIR \
    --predict_csv $PREDICT_CSV"
else
  CMD="python ../../run_model.py \
    --model $MODEL \
    --features $FEATURES \
    --csv $CSV_PATH \
    --outdir $OUTDIR \
    --splits 100 \
    --perm_repeats 10"
  [ "$SCRAMBLED" == "True" ] && CMD="$CMD --scrambled"
fi

echo "Running command: $CMD"
eval $CMD

echo "Finished at:" $(date)
END_TIME=$(date +%s)
RUNTIME=$((END_TIME - START_TIME))
echo "Total runtime: $((RUNTIME / 60)) minutes, $((RUNTIME % 60)) seconds"
